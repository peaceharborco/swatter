#!/usr/bin/env bash
# swatter — Cloudflare-aware abuse detection & blocking for cPanel/CSF.
#
# A server-side watchdog: it reads your web logs, scores each IP on weighted
# behavioral signals plus optional threat-intel, and blocks the malicious ones —
# routing direct-to-origin offenders to CSF and Cloudflare-proxied offenders to
# the Cloudflare WAF, so it can never firewall a Cloudflare edge and take your
# sites down.
#
# Report-only by default. Set SWATTER_MODE="enforce" to act.  MIT licensed.
#
# Usage:
#   swatter scan [--dry-run|--enforce]   ingest, score, decide, act
#   swatter status                       summary of state and last run
#   swatter top [-n N]                   worst tracked offenders
#   swatter why IP                       evidence/decision history for an IP
#   swatter allow IP|CIDR [note]         add to the never-block set (both planes)
#   swatter unblock IP [--perm-allow]    remove blocks; optionally allowlist
#   swatter list [temp|perm|cf|allow]    list current blocks/allowlist
#   swatter report [WINDOW] [--test|--print]  email a digest grouped by offense+action (--print: stdout only)
#   swatter refresh-feeds                update Cloudflare ranges + intel feeds
#   swatter test-config                  validate config + dependencies
#   swatter honeypot               print robots.txt + invisible-anchor snippet for the trap path
#   swatter setup-ipset            create ipset sets + iptables DROP rules (idempotent)
#   swatter origin-lock {apply|status|preflight|disable}  restrict :80/:443 to Cloudflare edges (L3)
#   swatter metrics [--print]      write the Prometheus textfile (or print it)
#   swatter export-bans [file]     write perm-ban list to file (or stdout)
#   swatter import-bans <file>     block each listed IP as perm (skips never-block/invalid)
#   swatter shared-egress-audit [--fix]  list (or unblock) perms on shared VPN egress
#   swatter swarm {enroll|status|disable|purge}  fleet reputation sharing (see SWARM_* config)
#   swatter escalate-preview [--window N]  who perms on their NEXT offense (read-only)
#   swatter rollback-ladder --since <epoch|iso> [--dry-run]   undo ladder perms
#   swatter pending [--drain-perms] [--dry-run]  inspect/drain the retry queue
#   swatter version

set -uo pipefail

# Every state/cache file Swatter creates (ledger, intel caches, cf-rules,
# cursors) is root-operational data: files 0640, dirs 0750, enforced here once
# rather than chmod'd at each write site.
umask 0027

SWATTER_ENTRYPOINT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
SWATTER_ARGV=("$@")
SWATTER_VERSION="2.12.0"

# Locate libs: installed layout (/usr/local/lib/swatter) or repo layout (../lib).
_self_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_self_dir}/../lib/common.sh" ]]; then
    LIBDIR="$(cd -- "${_self_dir}/../lib" && pwd)"
elif [[ -f /usr/local/lib/swatter/common.sh ]]; then
    LIBDIR=/usr/local/lib/swatter
else
    echo "swatter: cannot locate lib/ (looked in ../lib and /usr/local/lib/swatter)" >&2
    exit 1
fi

# shellcheck source=../lib/common.sh
source "${LIBDIR}/common.sh"
swatter_load_config
swatter_check_deps

# Capture the run clock once.
SWATTER_NOW_EPOCH="$(date -u +%s)"; export SWATTER_NOW_EPOCH

# Source the rest.
for m in allowlist classify ingest store_sqlite block_csf block_ipset block block_cf origin_lock intel asn metrics errors mailer notify report_abuseipdb score swarm alerts report; do
    # shellcheck disable=SC1090
    source "${LIBDIR}/${m}.sh"
done

cmd_scan() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --dry-run) SWATTER_MODE="report" ;;
            --enforce) SWATTER_MODE="enforce" ;;
            *) die "scan: unknown flag $arg" ;;
        esac
    done
    swatter_init_dirs
    swatter_acquire_lock
    # A broken ledger must ABORT the scan, not degrade silently: blocking without
    # the store loses caps, repeat-escalation, and perm tracking — worse than not
    # running, because the operator believes protection is intact.
    swatter_store_init || die "store init failed — aborting scan (ledger unusable)"
    swatter_intel_init
    log_info "swatter scan start (mode=${SWATTER_MODE})"
    swatter_scan
    # Fleet publish: delta of this run's confirmed perm bans, inside the scan
    # lock (spec §4.1). Fail-soft — a hub outage must never fail the scan.
    swatter_swarm_publish || true
}

cmd_status() {
    swatter_init_dirs; swatter_store_init
    echo "Swatter ${SWATTER_VERSION}"
    echo "  mode:        ${SWATTER_MODE}"
    echo "  config:      ${SWATTER_CONF}"
    echo "  store:       ${STORE}  (${STATE_DIR})"
    local cfsuffix=""
    [[ "${CF_MODE}" == "auto" ]] && cfsuffix=" -> $(swatter_cached_cf_verdict || true)"
    echo "  CF in use:   $(swatter_cf_in_use && echo yes || echo no)  (mode=${CF_MODE}${cfsuffix})"
    # An unhealthy range list only fails closed on a CF-fronted box; a bare box
    # doesn't need the list, so say so rather than implying blocks are disabled.
    if swatter_allowlist_healthy; then echo "  allowlist:   healthy"
    elif swatter_cf_fronted;     then echo "  allowlist:   UNHEALTHY (fail-closed — CSF denies disabled)"
    else                              echo "  allowlist:   n/a (not behind Cloudflare; CSF denies active)"; fi
    local intel="none"; [[ -n "${INTEL_PROVIDERS// }" ]] && intel="${INTEL_PROVIDERS}"
    echo "  intel:       ${intel}"
    if [[ "${STORE}" == "sqlite" && "${SWATTER_HAVE_SQLITE}" -eq 1 ]]; then
        local db; db="${STATE_DIR}/swatter.db"
        echo "  offenders:   $(sqlite3 "$db" 'SELECT COUNT(*) FROM offenders;' 2>/dev/null || echo 0) tracked"
        echo "  perm-blocks: $(sqlite3 "$db" 'SELECT COUNT(*) FROM offenders WHERE perm=1;' 2>/dev/null || echo 0)"
        echo "  actions:     $(sqlite3 "$db" 'SELECT COUNT(*) FROM actions;' 2>/dev/null || echo 0) logged"
    fi
    local dl="${LOG_DIR}/decisions.jsonl"
    [[ -f "$dl" ]] && echo "  decisions:   $(wc -l < "$dl" 2>/dev/null) lines ($dl)"
    echo "  origin-lock: $(swatter_origin_lock_summary)"
}

cmd_top() {
    local n=20
    # -n must be a positive integer — it is interpolated into a SQL LIMIT.
    if [[ "${1:-}" == "-n" ]]; then
        [[ "${2:-}" =~ ^[0-9]+$ ]] || die "usage: swatter top [-n N]  (N must be a positive integer)"
        n="$2"
    fi
    swatter_store_init
    printf '%-18s %5s %5s %5s %4s %-11s %s\n' "IP" "SCORE" "OFFN" "TEMP" "PERM" "CHANNEL" "LAST"
    swatter_store_top_offenders "$n" | while IFS=$'\t' read -r ip sc off tmp perm ch label; do
        printf '%-18s %5s %5s %5s %4s %-11s %s\n' "$ip" "$sc" "$off" "$tmp" "$perm" "$ch" "$label"
    done
}

cmd_why() {
    local ip="${1:-}"; [[ -n "$ip" ]] || die "usage: swatter why IP"
    swatter_validate_ip_or_cidr "$ip"
    swatter_store_init
    echo "== ledger history: ${ip} =="
    swatter_store_history "$ip"
    echo
    echo "== decision-log evidence: ${ip} =="
    local dl="${LOG_DIR}/decisions.jsonl"
    if [[ -f "$dl" ]]; then
        if [[ "${SWATTER_HAVE_JQ}" -eq 1 ]]; then
            jq -c "select(.ip==\"${ip}\")" "$dl" 2>/dev/null | tail -n 10
        else
            grep -F "\"ip\":\"${ip}\"" "$dl" 2>/dev/null | tail -n 10
        fi
    fi
}

cmd_unblock() {
    local ip="${1:-}" perm_allow=0
    [[ -n "$ip" ]] || die "usage: swatter unblock IP [--perm-allow]"
    swatter_validate_ip_or_cidr "$ip"
    [[ "${2:-}" == "--perm-allow" ]] && perm_allow=1
    # Serialize with a running scan — unblock rewrites cf-rules.tsv + the ledger.
    swatter_with_state_lock || die "a swatter scan is running (lock held) — try again in a moment"
    swatter_store_init
    # A backend failure must surface: nonzero exit + cause, never a false
    # "unblocked" while a deny/CF rule is still live. The ledger is still
    # cleared (perm flag off) so a later retry isn't blocked by stale state.
    local unblock_failed=0
    SWATTER_LAST_BACKEND_ERR=""
    swatter_block_direct_unblock "$ip" || unblock_failed=1
    swatter_cf_unblock "$ip" || unblock_failed=1
    swatter_store_unblock "$ip"
    if (( perm_allow )); then
        cmd_allow "$ip" "perm-allow after unblock"
        if [[ "${SWATTER_HAVE_CSF}" -eq 1 && "${SWATTER_MODE}" == "enforce" ]]; then
            csf -a "$ip" "swatter allowlist" >/dev/null 2>&1 || true
        fi
    fi
    if (( unblock_failed )); then
        echo "unblock ${ip} INCOMPLETE — a backend failed${SWATTER_LAST_BACKEND_ERR:+ (${SWATTER_LAST_BACKEND_ERR})}; blocks may still be live" >&2
        exit 1
    fi
    echo "unblocked ${ip}"
}

# swatter allow IP|CIDR [note] — add to the never-block set (OPERATOR_ALLOW_FILE).
# This is the guardrail against blocking your own clients: run report mode for a
# while, review would-blocks with `swatter why`, and allow the legitimate ones
# BEFORE enabling enforce.
cmd_allow() {
    local ip="${1:-}"; shift || true
    local note="${*:-}"
    [[ -n "$ip" ]] || die "usage: swatter allow IP|CIDR [note]"
    swatter_validate_ip_or_cidr "$ip"
    local f="${OPERATOR_ALLOW_FILE}"
    if [[ -f "$f" ]] && awk -v ip="$ip" '$1 == ip { found=1; exit } END { exit !found }' "$f"; then
        echo "already allowed: ${ip}"
        return 0
    fi
    mkdir -p "$(dirname "$f")" 2>/dev/null || true
    printf '%s # %s - %s\n' "$ip" "${note:-added via swatter allow}" \
        "$(date -u '+%Y-%m-%d %H:%M:%S UTC' -d "@${SWATTER_NOW_EPOCH}" 2>/dev/null \
           || date -u -r "${SWATTER_NOW_EPOCH}" '+%Y-%m-%d %H:%M:%S UTC')" >> "$f"
    # 0640 (not world-readable): the allow file lists operator/monitoring IPs —
    # infrastructure detail that shouldn't be legible to every user on a shared box.
    chmod 0640 "$f" 2>/dev/null || true
    log_info "never-block allow: ${ip}${note:+ (${note})}"
    echo "allowed ${ip} (never-block, both planes)"
}

cmd_list() {
    local what="${1:-temp}"
    case "$what" in
        temp) case "${DIRECT_BACKEND:-csf}" in
                ipset) swatter_ipset_list temp ;;
                *)     have csf && csf -t 2>/dev/null | grep -i swatter || echo "(none / csf unavailable)" ;;
              esac ;;
        perm) case "${DIRECT_BACKEND:-csf}" in
                ipset) swatter_ipset_list perm ;;
                *)     have csf && grep -i swatter /etc/csf/csf.deny 2>/dev/null || echo "(none)" ;;
              esac ;;
        allow)
            echo "# never-block (${OPERATOR_ALLOW_FILE}):"
            [[ -s "${OPERATOR_ALLOW_FILE}" ]] && grep -v '^#' "${OPERATOR_ALLOW_FILE}" || echo "(none)"
            echo "# csf.allow:"
            [[ -f /etc/csf/csf.allow ]] && grep -v '^#' /etc/csf/csf.allow || echo "(none)"
            ;;
        cf) swatter_cf_list_rules ;;
        *) die "usage: swatter list [temp|perm|cf|allow]";;
    esac
}

cmd_report() {
    swatter_init_dirs
    swatter_report "$@"
}

cmd_refresh_feeds() {
    swatter_init_dirs
    local rc=0
    # Cloudflare ranges (always — they gate the never-block set).
    if [[ "${SWATTER_HAVE_CURL}" -eq 1 ]]; then
        # Stage the temp beside the target so the install is an atomic same-fs
        # rename (a reader mid-refresh never sees a half-written cloudflare.cidr,
        # which gates the never-block set). Fall back to TMPDIR only if the target
        # dir is unwritable — the write then fails closed and cron alerts.
        local cf4 cf6 tmp cfdir; cfdir="$(dirname "${CLOUDFLARE_IPS_FILE}")"
        tmp="$(mktemp "${cfdir}/.swatter-cfranges.XXXXXX" 2>/dev/null)" \
            || tmp="$(mktemp "${TMPDIR:-/tmp}/swatter-cfranges.XXXXXX")" \
            || { log_error "refresh-feeds: mktemp failed"; return 1; }
        cf4="$(curl --max-time 20 -fsS https://www.cloudflare.com/ips-v4 2>/dev/null)"
        cf6="$(curl --max-time 20 -fsS https://www.cloudflare.com/ips-v6 2>/dev/null)"
        # Validate EACH family independently: swatter_cidr_list_ok requires >=1
        # valid CIDR line AND every non-blank line valid. Checking the families
        # separately means a v6 body that is empty OR whitespace-only OR a
        # captive-portal page fails its own gate — a bare -z check would let a
        # whitespace v6 body through and install a v4-only file (shrinking the
        # never-block set + origin-lock v6 coverage; an IPv6 CF edge could then be
        # CSF-denied). BOTH families must be independently good or the existing
        # (last-good, complete) file is kept: keeping slightly-stale-but-complete
        # ranges is far safer than writing a fresh-but-incomplete set, and the
        # allowlist freshness guard warns if it ages out.
        local v4ok=1 v6ok=1
        printf '%s\n' "$cf4" | swatter_cidr_list_ok || v4ok=0
        printf '%s\n' "$cf6" | swatter_cidr_list_ok || v6ok=0
        if (( ! v4ok || ! v6ok )); then
            log_error "cloudflare range download INVALID/incomplete (v4 $([[ $v4ok -eq 1 ]] && echo ok || echo BAD), v6 $([[ $v6ok -eq 1 ]] && echo ok || echo BAD)) — keeping existing ${CLOUDFLARE_IPS_FILE}"
            rc=1
        else
            # A validated body that never lands must not read as success to cron.
            if { printf '%s\n' "$cf4"; printf '%s\n' "$cf6"; } > "$tmp" 2>/dev/null \
               && chmod 0644 "$tmp" 2>/dev/null \
               && { mv -f "$tmp" "${CLOUDFLARE_IPS_FILE}" 2>/dev/null \
                    || cp "$tmp" "${CLOUDFLARE_IPS_FILE}" 2>/dev/null; }; then
                log_info "cloudflare ranges refreshed -> ${CLOUDFLARE_IPS_FILE}"
            else
                log_error "cloudflare range WRITE failed (${CLOUDFLARE_IPS_FILE}) — existing file kept"
                rc=1
            fi
        fi
        rm -f "$tmp"
    fi
    # Intel feeds. All-feeds-failed propagates so cron can alert.
    swatter_intel_init
    swatter_intel_refresh_all || rc=1

    # Corroborated-block sweep (opt-in): acts on the JUST-refreshed swarm meta,
    # entirely through _swatter_execute_block. No-op unless configured. Serialize
    # with a running scan; if a scan holds the lock, SKIP (non-fatal — feeds already
    # refreshed, and the sweep is idempotent next run) rather than fail the cron.
    if swatter_with_state_lock 30; then
        swatter_swarm_sweep || true
    else
        log_warn "swarm sweep skipped: a scan holds the state lock (retries next refresh)"
    fi

    # Re-run Cloudflare posture detection now that ranges are fresh. Only matters
    # for CF_MODE=auto, but caching it always keeps `status`/`test-config`
    # informative regardless of mode.
    swatter_detect_cf >/dev/null
    # GC stale on-disk state (orphaned curl cfgs, expired per-IP intel/crawler cache)
    # so a long-lived box's working set stays bounded. Daily cadence; never fatal.
    swatter_state_gc || true
    return "$rc"
}

cmd_test_config() {
    echo "Swatter ${SWATTER_VERSION} — config check"
    echo "  config file:    ${SWATTER_CONF} $( [[ -f ${SWATTER_CONF} ]] && echo '(found)' || echo '(MISSING — using defaults)')"
    echo "  gawk:           $(have gawk && echo ok || echo MISSING)"
    echo "  flock:          $(have flock && echo ok || echo MISSING)"
    echo "  jq:             $( [[ ${SWATTER_HAVE_JQ} -eq 1 ]] && echo ok || echo 'missing (intel/CF-direct disabled)')"
    echo "  curl:           $( [[ ${SWATTER_HAVE_CURL} -eq 1 ]] && echo ok || echo 'missing (intel/feeds disabled)')"
    echo "  sqlite3:        $( [[ ${SWATTER_HAVE_SQLITE} -eq 1 ]] && echo ok || echo 'missing (using flatfile)')"
    echo "  csf:            $( [[ ${SWATTER_HAVE_CSF} -eq 1 ]] && echo ok || echo 'missing (CSF plane disabled)')"
    echo "  badpaths:       ${BADPATHS_CONF} $( [[ -f ${BADPATHS_CONF} ]] && echo '(found)' || echo '(MISSING)')"
    echo "  CF ranges:      ${CLOUDFLARE_IPS_FILE} $( swatter_allowlist_healthy && echo '(healthy)' || echo '(missing/stale — run: swatter refresh-feeds)')"
    echo "  mode:           ${SWATTER_MODE}"
    # Effective control state — printed AFTER the same expansion the gates use,
    # so this answers "is the ladder armed right now", not "what does the conf
    # file say". Every deploy gate verifies against these lines.
    echo "  ladder:         $( [[ "${REPEAT_ENABLE}" == "true" ]] && echo 'ARMED' || echo 'DISARMED' ) (REPEAT_ENABLE=${REPEAT_ENABLE})"
    echo "  ladder knobs:   REPEAT_N=${REPEAT_N} window=${REPEAT_WINDOW_DAYS}d crit-single=${REPEAT_N_CRITICAL_SINGLE}"
    echo "  perm tripwire:  ${PERM_RATE_ALERT_PER_RUN}/run ${PERM_RATE_ALERT_PER_DAY}/day (ALERT floor — not an abort threshold)"
    echo "  publication:    swarm=${SWARM_PUBLISH:-true} abuseipdb=${ABUSEIPDB_REPORT}"
    # Shared-egress ships ENABLED but is entirely data-driven, and both lists
    # live under /etc/swatter — which a surgical file-by-file deploy never
    # creates. So the policy can read "on" and cap nothing at all, silently:
    # _swatter_shared_egress_cidr_usable warns only on a REJECTED file, never on
    # a missing one. Report the DATA (present? valid? how many entries?), not the
    # flag, and print it next to `publication:` because that is the decision it
    # informs. Deliberately in the effective-control-state block rather than the
    # advisory section below: this one is enforcement, not readiness.
    if [[ "${SHARED_EGRESS_ENABLE:-true}" == "true" ]]; then
        local se_cidr="${SHARED_EGRESS_CIDR_FILE:-unset}" se_asns="${SHARED_EGRESS_ASNS_FILE:-unset}"
        local se_cn=0 se_an=0 se_cok=0 se_aok=0 se_cstate se_astate
        if [[ ! -f "$se_cidr" ]]; then
            se_cstate="MISSING — deploy it; CIDR arm INERT"
        elif ! _swatter_shared_egress_cidr_usable; then
            se_cstate="REJECTED (invalid or over-broad line); CIDR arm INERT"
        else
            se_cn="$(grep -cE '^[[:space:]]*[^#[:space:]]' "$se_cidr" 2>/dev/null)"
            se_cok=1; se_cstate="${se_cn} range(s)"
        fi
        if _swatter_shared_egress_asns_usable; then
            se_an="$(grep -cE '^[[:space:]]*[0-9]' "$se_asns" 2>/dev/null)"
            se_aok=1; se_astate="${se_an} ASN(s)"
        elif [[ -f "$se_asns" ]]; then
            se_astate="0 entries; ASN arm inert (the shipped default)"
        else
            se_astate="MISSING; ASN arm inert"
        fi
        echo "  shared-egress:  ENABLED (a matching perm becomes a ladder-max temp, unpublished)"
        echo "                  cidr: ${se_cidr} (${se_cstate})"
        echo "                  asns: ${se_asns} (${se_astate})"
        (( se_cok || se_aok )) \
            || echo "                  WARNING: both arms inert -> the policy caps NOTHING and audits will read clean"
    else
        echo "  shared-egress:  off (SHARED_EGRESS_ENABLE=false) — perms on shared consumer VPN egress are NOT capped"
    fi
    local n=0 f
    for f in ${DOMLOGS_GLOB}; do [[ -f "$f" ]] && n=$(( n + 1 )); done
    local domlog_status=""
    (( n == 0 )) && domlog_status=" (WARNING: no matches — no scoring data)"
    echo "  domlogs:        ${n} files match ${DOMLOGS_GLOB}${domlog_status}"
    if [[ "${ERROR_DIGEST_ENABLE}" == "true" ]]; then
        local ef=0 em=0 ep=0
        for f in ${ERROR_FPM_GLOB}; do [[ -f "$f" ]] && ef=$(( ef + 1 )); done
        for f in ${ERROR_MYSQL_GLOB}; do [[ -f "$f" ]] && em=$(( em + 1 )); done
        for f in ${ERROR_PHP_HOME_GLOB}/*/logs/error_log ${ERROR_PHP_HOME_GLOB}/*/*/logs/error_log; do [[ -f "$f" ]] && ep=$(( ep + 1 )); done 2>/dev/null || true
        local err_status=""
        (( ef + em + ep == 0 )) && err_status=" (WARNING: no matches)"
        echo "  error logs:     fpm=${ef} mysql=${em} php=${ep}${err_status}"
    fi
    case "${CF_MODE}" in
        auto)
            # Refresh the verdict so the report reflects current DNS/config, not
            # a stale cache.
            local verdict; verdict="$(swatter_detect_cf 2>/dev/null)"
            local reason; reason="$(cut -f3 "${STATE_DIR}/cf-detect" 2>/dev/null | head -n1)"
            if [[ "$verdict" == "not-behind" ]]; then
                echo "  CF mode:        auto -> not-behind (${reason}); every offender is CSF-direct"
            elif [[ "$verdict" == "behind" ]]; then
                echo "  CF mode:        auto -> behind (${reason}); classification ON, Cloudflare plane in use"
            else
                echo "  CF mode:        auto -> uncertain (${reason:-no signal}); classification ON (safe)"
                echo "                  could not prove the box is bare — likely no domain-named logs to"
                echo "                  sample. If this server is NOT behind Cloudflare, set CF_MODE=\"off\""
                echo "                  explicitly so direct offenders aren't routed to the Cloudflare plane."
            fi
            ;;
        direct) echo "  CF mode:        direct (Swatter manages the Cloudflare plane)" ;;
        skip)   echo "  CF mode:        skip (your own edge rules own the CF plane; via-CF offenders logged only)" ;;
        off)    echo "  CF mode:        off (not behind Cloudflare; everything is CSF-direct)" ;;
        *)      echo "  CF mode:        ${CF_MODE} (UNKNOWN — expected auto|direct|skip|off; via-CF offenders will be logged, not acted on)" ;;
    esac
    # Surface CF credential/map status whenever the CF plane could be actively
    # managed: explicit direct, or auto that resolved to behind-Cloudflare.
    if [[ "${CF_MODE}" == "direct" ]] || { [[ "${CF_MODE}" == "auto" ]] && swatter_cf_fronted; }; then
        local ncreds=0 ndoms=0
        [[ -r "${CF_CREDS_FILE}" ]] && ncreds="$(grep -cvE '^[[:space:]]*(#|$)' "${CF_CREDS_FILE}" 2>/dev/null)"
        [[ -r "${CF_DOMAINS_MAP}" ]] && ndoms="$(grep -cvE '^[[:space:]]*(#|$)' "${CF_DOMAINS_MAP}" 2>/dev/null)"
        echo "  CF creds:       ${CF_CREDS_FILE} ($( [[ -r ${CF_CREDS_FILE} ]] && echo "${ncreds} account token(s)" || echo 'MISSING — run swatter-deploy-cf-creds.sh' ))"
        echo "  CF domain map:  ${CF_DOMAINS_MAP} ($( [[ -r ${CF_DOMAINS_MAP} ]] && echo "${ndoms} domain(s)" || echo 'MISSING' ))"
        echo "  CF action:      ${CF_ACTION}"
    fi
    echo
    echo "  --- v1.3 feature readiness (advisory) ---"
    local p
    for p in ${INTEL_PROVIDERS:-}; do
        case "$p" in
            greynoise)       [[ -n "${GREYNOISE_KEY:-}" ]] && echo "  intel greynoise: key set" || echo "  intel greynoise: key not set (GREYNOISE_KEY empty) -> provider inert" ;;
            projecthoneypot) [[ -n "${HTTPBL_KEY:-}" ]] && echo "  intel projecthoneypot: key set" || echo "  intel projecthoneypot: key not set (HTTPBL_KEY empty) -> provider inert" ;;
            abuseipdb)       [[ -n "${ABUSEIPDB_KEY:-}" ]] && echo "  intel abuseipdb: key set" || echo "  intel abuseipdb: key not set (ABUSEIPDB_KEY empty) -> provider inert" ;;
            swarm)           if [[ "${SWARM_ENABLE:-false}" == "true" && -n "${SWARM_HUB_URL:-}" ]]; then
                                 [[ -r "${SWARM_READ_TOKEN_FILE:-}" ]] && echo "  intel swarm: enabled (hub ${SWARM_HUB_URL})" \
                                     || echo "  intel swarm: read token MISSING (${SWARM_READ_TOKEN_FILE}) -> consume inert"
                             else echo "  intel swarm: SWARM_ENABLE/SWARM_HUB_URL not set -> provider inert"; fi ;;
        esac
    done
    if [[ "${ASN_SIGNAL_ENABLE:-false}" == "true" || " ${INTEL_PROVIDERS:-} " == *" projecthoneypot "* ]]; then
        [[ "${SWATTER_HAVE_DNS:-0}" -eq 1 ]] \
            && echo "  dns client: ${SWATTER_DNS_TOOL} (http:BL + ASN ok)" \
            || echo "  dns client: NONE -> http:BL + ASN inert (install dig/host)"
    fi
    if [[ "${ASN_SIGNAL_ENABLE:-false}" == "true" ]]; then
        [[ -s "${HOSTING_ASNS_FILE:-}" ]] && echo "  asn signal: hosting list ${HOSTING_ASNS_FILE} ($(grep -cE '^[0-9]' "${HOSTING_ASNS_FILE}" 2>/dev/null) ASNs)" \
            || echo "  asn signal: HOSTING_ASNS_FILE ${HOSTING_ASNS_FILE:-unset} missing/empty -> no boost"
    fi
    if [[ -n "${HONEYPOT_PATHS_FILE:-}" ]]; then
        [[ -s "${HONEYPOT_PATHS_FILE}" ]] && echo "  honeypot: ${HONEYPOT_PATHS_FILE} active (run 'swatter honeypot' to advertise)" \
            || echo "  honeypot: ${HONEYPOT_PATHS_FILE} empty/missing -> trap disabled"
    fi
    if [[ -n "${METRICS_FILE:-}" ]]; then
        local md; md="$(dirname "${METRICS_FILE}")"
        [[ -d "$md" && -w "$md" ]] && echo "  metrics: ${METRICS_FILE} writable" || echo "  metrics: ${md} missing/unwritable -> metrics skipped"
    fi
    echo "  --- v2.0 feature readiness (advisory) ---"
    echo "  direct backend: ${DIRECT_BACKEND:-csf}$( [[ "${DIRECT_BACKEND:-csf}" == "ipset" ]] && { [[ "${SWATTER_HAVE_IPSET}" -eq 1 ]] && echo ' (ipset/iptables present; run setup-ipset)' || echo ' -> ipset/iptables MISSING'; } )"
    echo "  origin-lock: $(swatter_origin_lock_summary)$( [[ "$(swatter_origin_lock_summary)" == *fail-open* ]] && echo ' (run: swatter refresh-feeds)' )"
    local ch=""
    [[ -n "${NOTIFY_EMAIL:-}" ]]     && ch="${ch}local-mail "
    [[ -n "${ALERT_EMAIL:-}" ]]      && ch="${ch}sendgrid-email "
    [[ -n "${ALERT_SMS_TO:-}" && -n "${TWILIO_SID:-}" ]] && ch="${ch}twilio-sms "
    [[ -n "${ALERT_WEBHOOK_URL:-}" ]] && ch="${ch}webhook "
    echo "  alerts: ${ch:-none configured}"
    [[ "${ABUSEIPDB_REPORT:-false}" == "true" ]] && echo "  abuseipdb reporting: ENABLED$( [[ -z "${ABUSEIPDB_KEY:-}" ]] && echo ' but ABUSEIPDB_KEY empty -> inert' )" || echo "  abuseipdb reporting: off"
}

cmd_honeypot() {
    local path
    path="$(awk 'NF && $1 !~ /^#/ {print; exit}' "${HONEYPOT_PATHS_FILE:-/nonexistent}" 2>/dev/null)"
    if [[ -z "$path" ]]; then
        path="/__trap_$(head -c4 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n' || echo a7f3c1d9)/"
        echo "# No HONEYPOT_PATHS_FILE entry found — suggested trap path: ${path}"
        echo "# Add it (anchored) to ${HONEYPOT_PATHS_FILE:-/etc/swatter/honeypot.paths}:"
        printf '#   %s(/|$)\n\n' "${path%/}"
    fi
    local clean="${path%(/\|$)}"; clean="${clean%/}"
    cat <<EOF
# --- robots.txt (advertise the trap so only path-scanning bots find it) ---
User-agent: *
Disallow: ${clean}/

# --- invisible anchor (drop into a shared template; humans never see it) ---
<a href="${clean}/" style="display:none" aria-hidden="true" rel="nofollow">do-not-follow</a>

# Any IP that requests ${clean}/ is scored 100 and permanently banned on its
# next Swatter scan (plane-classified + allowlist-checked as always).
EOF
}

cmd_export_bans() {
    swatter_store_init
    local out="${1:-}"
    if [[ -n "$out" ]]; then
        swatter_store_perm_ips > "$out"
        log_info "exported $(grep -c . "$out" 2>/dev/null || echo 0) perm ban(s) -> ${out}"
    else swatter_store_perm_ips; fi
}

cmd_import_bans() {
    local file="${1:-}"
    [[ -f "$file" ]] || die "usage: swatter import-bans <file>"
    # Serialize with a running scan — import-bans applies firewall denies + writes
    # the ledger. Wait longer than unblock: a large file can take a while.
    swatter_with_state_lock 60 || die "a swatter scan is running (lock held) — try again in a moment"
    # Like cmd_scan: import-bans WRITES the ledger (records each ban). A broken
    # store would firewall-block without recording — the exact divergence we guard
    # against — so abort before applying any block rather than leave untracked denies.
    swatter_store_init || die "store init failed — aborting import-bans (ledger unusable)"
    local line ip nb se n=0 dry
    dry="$([[ "${SWATTER_MODE}" == "enforce" ]] && echo 0 || echo 1)"
    local channel="${DIRECT_BACKEND:-csf}"
    # A deliberate operator import is NOT a scan — the per-run deny cap
    # (MAX_CSF_DENIES_PER_RUN, a scan runaway-guard) must not silently truncate it
    # at 10. Lift it for this process so every listed ban applies; never_block still
    # protects the allowlist, and the applied count is logged below.
    MAX_CSF_DENIES_PER_RUN=1000000
    # `|| [[ -n "$line" ]]` so a bans file whose LAST line has no trailing newline
    # still imports that ban instead of silently dropping it.
    while IFS= read -r line || [[ -n "$line" ]]; do
        ip="${line%%#*}"; ip="$(printf '%s' "$ip" | tr -d '[:space:]')"
        [[ -n "$ip" ]] || continue
        swatter_is_valid_ip_or_cidr "$ip" 2>/dev/null || { log_warn "import-bans: skip invalid '${ip}'"; continue; }
        if nb="$(swatter_is_never_block "$ip")"; then log_info "import-bans: skip never-block ${ip} (${nb})"; continue; fi
        # import-bans writes perms itself and never reaches _swatter_apply_plane,
        # so the shared-egress veto there cannot see it. Skip rather than
        # silently downgrade: an operator importing a list should be told the
        # entry was refused, not quietly given something else.
        #
        # A CIDR token is refused WHOLE, and loudly, when it overlaps a
        # shared-egress range in either direction — importing 104.28.0.0/16 must
        # not perm-ban all of consumer WARP just because the token is a prefix
        # rather than one of its member addresses. Partially applying the
        # non-overlapping remainder would be worse than refusing: the operator's
        # list and the firewall would silently disagree about what got banned.
        if [[ "${SHARED_EGRESS_ENABLE:-true}" == "true" ]] && se="$(swatter_is_shared_egress "$ip")"; then
            if [[ "$ip" == */* ]]; then
                log_warn "import-bans: REFUSED ${ip} — overlaps shared consumer VPN egress (${se}); a permanent ban on that prefix would blanket a shared pool"
            else
                log_info "import-bans: skip shared-egress ${ip} (${se}) — permanent bans on shared consumer VPN egress are policy-capped"
            fi
            continue
        fi
        if swatter_block_direct_perm "$ip" "imported ban"; then
            swatter_store_record "$ip" perm "$channel" 0 90 "imported ban" "$dry"
            # Record the per-plane ledger row too (enforced imports only) so a
            # later scan sees this IP as perm on the DIRECT plane and does not
            # re-dispatch it (swarm) or treat it as a legacy backfill (scan).
            [[ "$dry" == 0 ]] && swatter_store_plane_set "$ip" "$channel" perm 0
            n=$(( n + 1 ))
        fi
    done < "$file"
    log_info "import-bans: ${n} ban(s) applied (mode=${SWATTER_MODE}, backend=${channel})"
}

# swatter shared-egress-audit [--fix] [--force]
#
# Lists permanent bans that the shared-egress policy would now refuse to place.
# The veto in _swatter_apply_plane is forward-only: it stops new perms, it does
# not clear perms already on the books.
#
# --fix UNBLOCKS ONLY. It deliberately does not allowlist: these addresses
# rotate between clients, so a per-IP never-block would become a standing free
# pass for whoever receives the address next. Future offenses are the veto's job.
cmd_shared_egress_audit() {
    local fix=0 force=0 max="${SHARED_EGRESS_AUDIT_MAX:-25}"
    while (( $# )); do
        case "$1" in
            --fix)   fix=1 ;;
            --force) force=1 ;;
            *) die "usage: swatter shared-egress-audit [--fix] [--force]" ;;
        esac; shift
    done
    [[ "${STORE}" == "sqlite" ]] || die "shared-egress-audit needs the sqlite store"
    # Without this, a missing/unopenable store makes swatter_store_perm_ips_since
    # return nothing and the audit prints the same reassuring "no permanent bans
    # match" as a genuinely clean fleet.
    swatter_store_init || die "shared-egress-audit: store init failed — an empty result would be meaningless"
    # Same reason, for the policy's own inputs. The lists live in /etc/swatter and
    # a file-by-file deploy never creates them, so "enabled" does not imply
    # "armed": with neither arm usable NOTHING can ever match and a clean audit
    # means only that the audit could not look. That matters more here than
    # anywhere else — the operator's next move after a clean sweep is unfreezing
    # AbuseIPDB publication, which has no undo.
    [[ "${SHARED_EGRESS_ENABLE:-true}" == "true" ]] \
        || die "shared-egress-audit: SHARED_EGRESS_ENABLE=false — the policy is off, so nothing can match; this is not a clean bill of health"
    local cidr_ok=0 asn_ok=0
    # This also PRIMES _SW_SHARED_CIDR_OK in this shell, so the per-IP calls below
    # (each a $( ) subshell) inherit the verdict instead of re-validating and
    # re-warning once per row.
    _swatter_shared_egress_cidr_usable && cidr_ok=1
    _swatter_shared_egress_asns_usable && asn_ok=1
    (( cidr_ok || asn_ok )) || die "shared-egress-audit: no usable data source — ${SHARED_EGRESS_CIDR_FILE:-unset} is missing or rejected and ${SHARED_EGRESS_ASNS_FILE:-unset} has no entries. Nothing can match; deploy the lists (RUNBOOK: Shared consumer-VPN egress) before reading a clean result as clean."
    # A malformed SHARED_EGRESS_AUDIT_MAX (e.g. "1 2") makes the `(( ... ))`
    # comparison below a syntax error, which the surrounding `&&` swallows —
    # the gate would silently fail OPEN and let a mass unblock through. Same
    # idiom as swatter_store_perm_ips_since (lib/store_sqlite.sh) and
    # swatter_with_state_lock (lib/common.sh) use for the same reason.
    [[ "$max" =~ ^[0-9]+$ ]] || max=25

    local ip ts label ips=() labels=() scanned=0
    while IFS=$'\t' read -r ip ts; do
        [[ -n "$ip" ]] || continue
        scanned=$(( scanned + 1 ))
        label="$(swatter_is_shared_egress "$ip")" || continue
        ips+=("$ip"); labels+=("$label")
    done < <(swatter_store_perm_ips_since 0)

    if (( ${#ips[@]} == 0 )); then
        # Say what was actually checked against what. "No matches" over an empty
        # ledger, or against one live arm out of two, is a much weaker statement
        # than it reads as.
        printf 'shared-egress-audit: no permanent bans match the shared-egress policy (%d perm ban(s) checked; cidr arm %s, asn arm %s).\n' \
            "$scanned" \
            "$( (( cidr_ok )) && echo 'live' || echo 'inert' )" \
            "$( (( asn_ok  )) && echo 'live' || echo 'inert' )"
        return 0
    fi

    local i
    if (( ! fix )); then
        printf 'shared-egress-audit: %d permanent ban(s) match (read-only)\n\n' "${#ips[@]}"
        for i in "${!ips[@]}"; do printf '  %-39s %s\n' "${ips[$i]}" "${labels[$i]}"; done
        printf '\nRe-run with --fix to unblock these. --fix does NOT allowlist.\n'
        return 0
    fi

    # Count gate: an over-broad list must not mass-lift silently.
    if (( ${#ips[@]} > max && ! force )); then
        die "shared-egress-audit: ${#ips[@]} IPs selected, over the ${max} safety limit — review the list first, then re-run with --force"
    fi

    local rc=0
    swatter_with_state_lock 60 || die "shared-egress-audit: could not take the state lock"
    for i in "${!ips[@]}"; do
        ip="${ips[$i]}"
        local failed=0
        SWATTER_LAST_BACKEND_ERR=""
        # Both backends unconditionally (no &&-short-circuit): a perm can be
        # dual-planed, so a failed direct-plane unblock must not skip the
        # Cloudflare unblock for the same IP. Their exit codes ARE the
        # verification — swatter_csf_unblock/swatter_cf_unblock only return 0
        # when the underlying `csf -tr/-dr` or CF rule-delete actually
        # succeeded (lib/block_csf.sh, lib/block_cf.sh).
        swatter_block_direct_unblock "$ip" || failed=1
        swatter_cf_unblock "$ip"           || failed=1
        # swatter_store_unblock runs regardless of $failed, same as
        # cmd_unblock/cmd_rollback_ladder: it unconditionally clears
        # offenders.perm AND plane_blocks (swatter_store_plane_clear), so a
        # POST-hoc swatter_store_is_perm_on check here would always read
        # "not on" — it would be re-querying a ledger this same call just
        # wiped, not the live firewall/CF state, and could never catch a
        # real divergence. $failed (the backend calls' own exit codes) is
        # the only real verification available; clearing the ledger either
        # way keeps a later retry of this IP from being blocked by stale
        # perm/plane state.
        swatter_store_unblock "$ip"
        if (( failed )); then
            printf '  %-39s PARTIAL%s\n' "$ip" "${SWATTER_LAST_BACKEND_ERR:+ (${SWATTER_LAST_BACKEND_ERR})}"
            rc=1
        else
            printf '  %-39s ok (%s)\n' "$ip" "${labels[$i]}"
        fi
    done
    # "no backend reported a failure", not "confirmed clear": swatter_cf_unblock
    # returns 0 without checking anything when cf-rules.tsv has no ref for the IP
    # (lib/block_cf.sh), and swatter_csf_unblock returns 0 with only a warning
    # when csf isn't installed (lib/block_csf.sh) — neither is a live-state
    # confirmation, so the message must not claim more than $failed established.
    (( rc == 0 )) \
        && printf '\nshared-egress-audit: %d unblocked (no backend reported a failure).\n' "${#ips[@]}" \
        || printf '\nshared-egress-audit: FINISHED WITH FAILURES — re-run and check `swatter list perm` / `csf -g <ip>`.\n' >&2
    return "$rc"
}

cmd_escalate_preview() {
    local win="${REPEAT_WINDOW_DAYS}"
    while (( $# )); do
        case "$1" in
            # Must validate $# BEFORE shift 2: with --window as the last arg,
            # $2 is unset and `shift 2` (N > $#) fails and leaves positionals
            # UNCHANGED under bash's shift semantics — and since this repo runs
            # `set -uo pipefail` without `-e`, that failure is swallowed, $1 is
            # still "--window" next iteration, and the while loop spins forever.
            --window)
                [[ $# -ge 2 ]] || die "usage: swatter escalate-preview [--window N]"
                win="$2"; shift 2 ;;
            *) die "usage: swatter escalate-preview [--window N]" ;;
        esac
    done
    [[ "$win" =~ ^[0-9]+$ ]] && (( win >= 1 )) || die "escalate-preview: --window must be a positive integer"
    # Read-only: no state lock needed, and deliberately not taken so this can be
    # run while the */5 scan is mid-flight.
    #
    # The legend goes to STDERR, not stdout: the header line is the whole
    # machine-readable contract (`... | awk -F'\t'`), and a multi-line note in
    # the middle of it would break every downstream reader. The column is named
    # temps_prior on purpose — it is the count ALREADY on the ledger, and the
    # decider counts the PENDING offense too, so a listed IP's eventual ban
    # reads recidivism=<temps_prior>+1.
    cat >&2 <<EOS
escalate-preview: window=${win}d REPEAT_N=${REPEAT_N} ladder=$( [[ "${REPEAT_ENABLE}" == "true" ]] && echo "ARMED" || echo "DISARMED (REPEAT_ENABLE=false)" )
  temps_prior  enforced temps ALREADY counted; the next offense adds one more,
               so the resulting ban reads recidivism=<temps_prior>+1
  status       at-bar   = temps_prior >= REPEAT_N (at/over the raw bar)
               one-away = temps_prior == REPEAT_N-1
  Both statuses perm on their NEXT offense ONLY IF THE LADDER IS ARMED
  (REPEAT_ENABLE=true, see the ladder= line above) — that is what this list is
  for. With the ladder disarmed, neither status converts to a perm on its own;
  an IP can still perm independently via honeypot / hard-intel dual-plane /
  plane-upgrade, none of which this list models.
  Not modeled here: REPEAT_N_CRITICAL_SINGLE raises the bar for offenders whose
  in-window temps were all single CRITICAL probes, so a few listed IPs will get
  one more temp instead. The list errs toward over-reporting, never under.
EOS
    printf 'ip\ttemps_prior\tlast_temp_utc\tstatus\n'
    swatter_escalate_preview "$win"
}


# swatter rollback-ladder --since <epoch|iso> [--dry-run] — bulk undo for perm
# bans placed by the recidivism ladder (Task 3), since a permanent ban on the
# direct plane never expires and a shell loop over `swatter unblock` is not a
# viable recovery path (see the header comment on swatter_ladder_perms_since
# and the commit message for why: decisions.jsonl rotates weekly with
# compress, cmd_unblock dies on a 30s lock wait, and a backend failure still
# clears the ledger before exiting non-zero).
cmd_rollback_ladder() {
    local since="" dry=0
    while (( $# )); do
        case "$1" in
            # Must validate $# BEFORE shift 2 — see cmd_escalate_preview's
            # --window handling for why: with --since as the last arg, $2 is
            # unset and `shift 2` (N > $#) fails and leaves positionals
            # UNCHANGED under bash's shift semantics. Since this repo runs
            # `set -uo pipefail` without `-e`, that failure is swallowed, $1
            # stays "--since", and the while loop spins forever.
            --since)
                [[ $# -ge 2 ]] || die "usage: swatter rollback-ladder --since <epoch|iso> [--dry-run]"
                since="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            *) die "usage: swatter rollback-ladder --since <epoch|iso> [--dry-run]" ;;
        esac
    done
    [[ -n "$since" ]] || die "usage: swatter rollback-ladder --since <epoch|iso> [--dry-run]"
    if ! [[ "$since" =~ ^[0-9]+$ ]]; then
        since="$(date -u -d "$since" +%s 2>/dev/null)" || die "rollback-ladder: unparseable --since"
    fi
    # ONE lock acquisition for the whole run, not per IP: a 67-IP loop taking
    # cmd_unblock's 30s-wait lock per iteration would contend with the */5 scan
    # cron and abort mid-list. swatter_with_state_lock only GATES entry (it
    # does not itself run a command under the lock — unlike cmd_unblock and
    # cmd_import_bans, which call it once and then do their work inline), so
    # acquire it here, once, before doing any work, and hold it (the fd stays
    # open for the rest of this process) for the entire selection+unblock loop.
    # Skipped for --dry-run: a preview mutates nothing, so — deliberately,
    # mirroring cmd_escalate_preview's read-only no-lock design — it must be
    # runnable while a scan holds the lock, not blocked behind it for up to 120s.
    (( dry )) || swatter_with_state_lock 120 || die "a swatter scan is running (lock held) — try again in a moment"
    local ips; ips="$(swatter_ladder_perms_since "$since")" || die "rollback-ladder: ledger query failed"
    if [[ -z "$ips" ]]; then echo "no ladder perms since ${since}"; return 0; fi
    local total=0 ok=0 bad=0
    while read -r ip; do
        [[ -n "$ip" ]] || continue
        total=$(( total + 1 ))
        if (( dry )); then echo "would unblock ${ip}"; ok=$(( ok + 1 )); continue; fi
        # Continue past a per-IP backend failure — a partial undo that stops
        # halfway is worse than one that finishes and reports which IPs need a
        # retry. Ledger is cleared either way (matches cmd_unblock): a later
        # retry of the same IP must not be blocked by stale perm state.
        #
        # Both backends are called UNCONDITIONALLY (no &&-short-circuit): a
        # ladder perm can be dual-planed (CSF + Cloudflare, see
        # _swatter_maybe_dual_plane in lib/score.sh), so a failed direct-plane
        # unblock must never skip the Cloudflare unblock for the same IP — that
        # would leave a live CF access rule with no report that CF was ever
        # attempted, i.e. exactly the half-applied state this command exists to
        # prevent.
        local ip_failed=0 failmsg=""
        SWATTER_LAST_BACKEND_ERR=""
        if ! swatter_block_direct_unblock "$ip"; then
            ip_failed=1
            failmsg="direct${SWATTER_LAST_BACKEND_ERR:+ (${SWATTER_LAST_BACKEND_ERR})}"
        fi
        SWATTER_LAST_BACKEND_ERR=""
        if ! swatter_cf_unblock "$ip"; then
            ip_failed=1
            failmsg="${failmsg:+${failmsg}; }cloudflare${SWATTER_LAST_BACKEND_ERR:+ (${SWATTER_LAST_BACKEND_ERR})}"
        fi
        swatter_store_unblock "$ip"
        if (( ip_failed )); then
            bad=$(( bad + 1 ))
            echo "PARTIAL ${ip}: ${failmsg} failed; ledger cleared, firewall may still hold" >&2
        else
            ok=$(( ok + 1 ))
            echo "unblocked ${ip}"
        fi
    done <<< "$ips"
    printf 'rollback-ladder: %d selected, %d unblocked, %d partial\n' "$total" "$ok" "$bad"
    # Same class of gap as the swarm notice below, and the operator following
    # the documented recovery path has no other way to learn about it: a ladder
    # perm is reported to AbuseIPDB when ABUSEIPDB_REPORT=true (and with the
    # default ABUSEIPDB_REPORT_MIN_ACTION=perm, ladder perms are EXACTLY what
    # gets reported — see lib/score.sh's report gate). Unblocking locally does
    # not withdraw that report, so a rolled-back customer IP stays publicly
    # listed as an abuser with nothing on screen to say so.
    if [[ "${ABUSEIPDB_REPORT:-false}" == "true" ]]; then
        cat >&2 <<'EOS'
NOTE: perm bans already reported to AbuseIPDB are NOT withdrawn by this command.
      ABUSEIPDB_REPORT=true, so these IPs were reported as abusers when they were
      banned and remain publicly listed. AbuseIPDB has no API to delete a report:
      request removal through their contact form ("remove my reports" / report
      correction) from the account that owns the API key.
EOS
    fi
    # The swarm gap is real and must not be silent: the hub has no per-IP
    # retract, only a host-wide purge with a 7-day TTL.
    if [[ "${SWARM_ENABLE:-false}" == "true" ]]; then
        cat >&2 <<'EOS'
NOTE: perm bans already published to the swarm hub are NOT retracted by this
      command. The hub has only a host-wide purge and a 7-day TTL, so peers may
      act on these IPs until the entries expire. Run `swatter swarm purge` only
      if you intend to drop ALL of this host's contributions.
EOS
    fi
    (( bad == 0 ))
}

cmd_setup_ipset() { swatter_ipset_setup; }

cmd_metrics() {
    if [[ "${1:-}" == "--print" ]]; then swatter_metrics_emit; else swatter_metrics_write; fi
}

# swatter pending [--drain-perms] [--dry-run] — inspect or drain the durable
# retry queue. Exists because the abort path needs it: disarming the ladder
# HOLDS queued perms (lib/score.sh) but does not clear them, and without this
# an operator's only option was hand-SQL against pending_blocks.
cmd_pending() {
    local drain=0 dry=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --drain-perms) drain=1; shift ;;
            --dry-run)     dry=1;   shift ;;
            *) die "usage: swatter pending [--drain-perms] [--dry-run]" ;;
        esac
    done
    swatter_store_init
    # Capture the read's OWN return code BEFORE anything else touches it. The
    # previous form piped straight into `tr` (`swatter_store_pending_list | tr
    # '\036' '\n'`), so `$?` reflected tr's exit status — always 0 — never
    # swatter_store_pending_list's. A genuine read failure (locked/corrupt db)
    # therefore produced empty stdout with a discarded nonzero rc, which the
    # next check couldn't tell apart from a truly empty queue: it printed
    # "queue is empty", exited 0, and cleared nothing. Verified live: with
    # sqlite3 returning "database is locked", `swatter pending --drain-perms`
    # reported an empty queue while a recidivism= perm stayed queued — exactly
    # the abort-step-2 silent no-op this command exists to prevent. A read
    # failure must look nothing like an empty queue: distinct message,
    # nonzero exit, so an abort script (or an operator re-running this by
    # hand) cannot mistake "could not read" for "already clear".
    local raw rlrc
    raw="$(swatter_store_pending_list)"; rlrc=$?
    if (( rlrc != 0 )); then
        echo "pending: FAILED to read the queue (rc=${rlrc}) — NOT confirmed empty. Database may be locked or corrupt; see the sqlite warning above. Nothing was inspected or cleared; retry." >&2
        return 1
    fi
    # Command substitution strips trailing NEWLINES but not a trailing RS —
    # and .mode ascii terminates every row, including the last, with RS. Left
    # in place, that trailing RS survives the translation below as a trailing
    # "\n" in $rows, and the <<< here-string appends its own newline on top,
    # so each read loop iterates one extra time over an empty synthetic row
    # after the real table (blank ip/action -> a phantom row in `pending`'s
    # output; harmless to --drain-perms since action never matches "perm").
    # Strip it before splitting. A genuinely empty queue has no trailing RS
    # (raw is ""), so this is a no-op on that path.
    raw="${raw%$'\036'}"
    # RS (0x1E) terminates rows in .mode ascii; convert to newlines so the
    # read loops below iterate per row.
    local rows; rows="${raw//$'\036'/$'\n'}"
    if [[ -z "$rows" ]]; then echo "pending: queue is empty"; return 0; fi
    printf '%-18s %-8s %-6s %5s  %s\n' "IP" "PLANE" "ACTION" "ATT" "REASON"
    # swatter_store_pending_list emits US-delimited fields and RS-terminated
    # rows (.mode ascii) — NOT tabs. bash treats tab as IFS-whitespace however
    # IFS is set, so adjacent tabs collapse and shift every later column.
    local ip plane action ttl folded rep ff attempts audit reason vhost ev
    while IFS=$'\037' read -r ip plane action ttl folded rep ff attempts audit reason vhost ev; do
        # swatter_store_pending_list runs via _sql_ascii, whose `.mode ascii`
        # output bypasses the sqlite3 CLI's own terminal-escape-injection
        # hardening (see _sql_ascii's comment in lib/store_sqlite.sh) — that
        # hardening is exactly what stops a control byte in `reason` from
        # doing something to this tty. reason's write-time cleaning
        # (swatter_store_pending_set) only strips the delimiter bytes
        # (TAB/CR/LF/US/RS), not ESC — and reason can carry a CF API error
        # summary (_cf_err_summary in lib/block_cf.sh), a narrower-trust
        # string than the rest of the mostly-internal reason vocabulary. This
        # is the one field here rendered to a human terminal, so sanitize it
        # here rather than assume it arrived clean.
        printf '%-18s %-8s %-6s %5s  %s\n' "$ip" "$plane" "$action" "$attempts" "${reason//[[:cntrl:]]/}"
    done <<< "$rows"
    (( drain )) || return 0
    # Mirrors cmd_rollback_ladder's ok/bad accounting for the same reason: a
    # bulk destructive op must never report success for a row it didn't
    # actually clear. swatter_store_pending_clear -> _sql logs a warning and
    # returns nonzero on failure (a locked/busy DB — entirely plausible during
    # a concurrent */5 retry scan, i.e. exactly when an operator runs this
    # during an active incident) but does NOT die or propagate on its own, so
    # the return code MUST be checked per row here or a partial drain would
    # print as a complete one — an operator would believe the queue is empty
    # while permanent bans are still queued to land, the exact failure this
    # command exists to prevent.
    local n=0 cleared=0 failed=0 held=0
    while IFS=$'\037' read -r ip plane action ttl folded rep ff attempts audit reason vhost ev; do
        [[ "$action" == "perm" ]] || continue
        # Leave a genuine honeypot intent queued: the disarm gate
        # (_swatter_retry_pending in lib/score.sh) deliberately keeps these
        # live while the ladder is disarmed — a trap hit is a separate,
        # always-on protection, not a ladder escalation — so an explicit
        # drain must not discard what that gate just chose to keep armed.
        # Match on the `ev` evidence marker, not free text in `reason`: the
        # default INTEL_PROVIDERS list ships a provider literally named
        # "projecthoneypot", so a plain ladder perm scored via that feed
        # renders as "intel=projecthoneypot:..." and a reason substring match
        # on "honeypot" would wrongly hold/drop that one instead.
        if [[ "$ev" == *'"honeypot":1'* ]]; then held=$(( held + 1 )); continue; fi
        n=$(( n + 1 ))
        (( dry )) && continue
        if swatter_store_pending_clear "$ip" "$plane"; then
            cleared=$(( cleared + 1 ))
        else
            failed=$(( failed + 1 ))
            echo "PARTIAL ${ip}/${plane}: clear failed; still queued" >&2
        fi
    done <<< "$rows"
    local heldmsg=""
    (( held > 0 )) && heldmsg=" (${held} honeypot intent(s) held, not drained — still fires while disarmed)"
    if (( dry )); then
        echo "pending: would clear ${n} queued perm intent(s) (--dry-run)${heldmsg}"
        return 0
    fi
    if (( failed > 0 )); then
        echo "pending: cleared ${cleared} of ${n} queued perm intent(s) — ${failed} FAILED (database busy?); re-run${heldmsg}"
        return 1
    fi
    echo "pending: cleared ${cleared} queued perm intent(s)${heldmsg}"
}

usage() { sed -n '2,34p' "${SWATTER_ENTRYPOINT}" | sed 's/^# \{0,1\}//'; }

main() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        scan)          cmd_scan "$@" ;;
        status)        cmd_status ;;
        top)           cmd_top "$@" ;;
        why)           cmd_why "$@" ;;
        allow)         cmd_allow "$@" ;;
        unblock)       cmd_unblock "$@" ;;
        list)          cmd_list "$@" ;;
        report)        cmd_report "$@" ;;
        refresh-feeds) cmd_refresh_feeds ;;
        test-config)   cmd_test_config ;;
        honeypot)      cmd_honeypot ;;
        setup-ipset)   cmd_setup_ipset ;;
        origin-lock)   cmd_origin_lock "$@" ;;
        metrics)       cmd_metrics "$@" ;;
        export-bans)   cmd_export_bans "$@" ;;
        import-bans)   cmd_import_bans "$@" ;;
        shared-egress-audit) cmd_shared_egress_audit "$@" ;;
        swarm)         cmd_swarm "$@" ;;
        escalate-preview) cmd_escalate_preview "$@" ;;
        rollback-ladder)  cmd_rollback_ladder "$@" ;;
        pending)       cmd_pending "$@" ;;
        version|--version|-v) echo "swatter ${SWATTER_VERSION}" ;;
        ""|help|-h|--help) usage ;;
        *) echo "swatter: unknown command '${sub}' (try: swatter help)" >&2; exit 2 ;;
    esac
}
main "$@"
