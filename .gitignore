# Local runtime state — never committed
*.db
*.db-journal
*.db-wal
*.db-shm
cursors.tsv
decisions.jsonl
*.log

# Live config holds API keys; only the example is tracked
swatter.conf
/etc-swatter/

# Scratch / editor
*.swp
*.tmp
.DS_Store
test/fixtures/*.local
grok-review/          # one-off external code-review scratch (spec + findings)

# draft marketing — keep out of the public repo
docs/launch-post.md

# Private deployment data — client lists, tokens, allowlists. These live in the
# operator's own private repo / on the server and are pushed by the deploy
# scripts; they must never be tracked here even if copied in for staging.
*.creds
*.key
cf-domains.map
cf-domains.conf
allow.cidr
*.local.conf
